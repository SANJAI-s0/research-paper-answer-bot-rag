# ==============================================================================
# Research Paper Answer Bot - Environment Configuration
# ==============================================================================
# Instructions:
# Copy this file to .env and set your Google Gemini API Key:
# cp .env.example .env (or copy on Windows)
# ==============================================================================

# Google Gemini API Key (Required for LLM generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Temperature for LLM Generation (0.0 recommended for strict grounded RAG)
GEMINI_TEMPERATURE=0.0

# Embedding Model Selection (HuggingFace open-source)
# Options: sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval Configuration
RETRIEVAL_STRATEGY=hybrid
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.35

# Storage Directories
CHROMA_PERSIST_DIR=./chroma_db
DATA_PAPERS_DIR=./data/papers
OUTPUTS_DIR=./outputs
