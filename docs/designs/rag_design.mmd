        CTX["Top-3 Retrieved Passages:<br/>&lt;source id='1' title='Attention Is All You Need' page='4'&gt;...&lt;/source&gt;<br/>&lt;source id='2' title='...' page='...'&gt;...&lt;/source&gt;"]
